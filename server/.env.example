# ai-provider-adapter.mjs configuration
# Copy this file to `.env` (same directory) and fill in real values.
# `.env` MUST NOT be committed to git -- add it to .gitignore.

# Provider type. One of:
#   openai-compatible  (OpenAI, OpenRouter, CrofAI, etc.)
#   ollama             (local Ollama server)
#   lm-studio          (alias of openai-compatible; LM Studio at http://localhost:1234)
AI_PROVIDER_TYPE=openai-compatible

# Base URL of the provider's API (no trailing slash). Examples:
#   https://api.openai.com
#   https://api.openai.com/v1          (also accepted)
#   https://openrouter.ai/api
#   https://openrouter.ai/api/v1       (also accepted)
#   http://localhost:11434              (Ollama default)
#   http://localhost:1234               (LM Studio default)
AI_PROVIDER_BASE_URL=

# API key (Bearer token). Leave blank for providers that don't require one
# (Ollama, LM Studio in default config).
AI_PROVIDER_API_KEY=

# Model identifier as the provider expects.
AI_PROVIDER_MODEL=

# Generation mode:
#   provider-default  do not send temperature/max tokens; let the selected model/provider decide
#   manual            send AI_PROVIDER_TEMPERATURE and AI_PROVIDER_MAX_TOKENS
AI_PROVIDER_GENERATION_MODE=provider-default

# Manual sampling defaults (used only when AI_PROVIDER_GENERATION_MODE=manual)
AI_PROVIDER_TEMPERATURE=0.7
AI_PROVIDER_MAX_TOKENS=1024

# HTTP listen port (defaults to 8765)
PORT=8765
