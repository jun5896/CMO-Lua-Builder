<Application x:Class="CmoWorkbench.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Surface" Color="#162230" />
    <SolidColorBrush x:Key="Input" Color="#0D1721" />
    <SolidColorBrush x:Key="Line" Color="#344457" />
    <SolidColorBrush x:Key="Muted" Color="#ACBDC9" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E7EEF5"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Control"><Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#E7EEF5"/><Setter Property="Background" Value="{StaticResource Input}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="CaretBrush" Value="#6EDCC6"/><Setter Property="SelectionBrush" Value="#356C78"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E7EEF5"/><Setter Property="Background" Value="#263B4D"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="13,9"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,7,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#365266"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#6EDCC6"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#13202D"/><Setter Property="Background" Value="#E0E9F1"/>
      <Setter Property="Padding" Value="8,7"/><Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/></Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="18,9"/><Setter Property="Foreground" Value="#E7EEF5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabBorder" Background="#1C2D3D" BorderBrush="#344457" BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}">
          <ContentPresenter ContentSource="Header"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#315859"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
