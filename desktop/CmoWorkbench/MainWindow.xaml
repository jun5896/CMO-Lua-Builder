<Window x:Class="CmoWorkbench.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CMO Workbench" Width="1380" Height="900" MinWidth="1080" MinHeight="740" Background="#0B141D" Foreground="#E7EEF5" FontFamily="Segoe UI, Malgun Gothic" FontSize="13" WindowStartupLocation="CenterScreen">
  <Grid Background="#0B141D">
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions>
    <Border Background="#111F2D" BorderBrush="#344457" BorderThickness="0,0,0,1" Padding="24,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="DESKTOP · CMO" Foreground="#6EDCC6" FontWeight="SemiBold" HorizontalAlignment="Right"/>
          <TextBlock Text="제작 · Lua 보조 · 플레이 조언" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel><TextBlock Text="CMO Workbench" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="시나리오를 만들고, 세력별로 생각을 정리하세요." Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Margin="18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="16">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="작업 공간" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="시나리오 · 세력마다 독립된 대화" Foreground="{StaticResource Muted}" Margin="0,6,0,16"/><Button Content="＋ 새 작업 공간" Click="NewSession_Click" Margin="0,0,0,12"/></StackPanel>
          <ListBox x:Name="SessionList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#E7EEF5" SelectionChanged="SessionList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Caption}" FontSize="11" Foreground="#92A8B9" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="OMP 연결" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <TextBox x:Name="OmpPath" ToolTip="OMP 실행 파일 경로. 계정과 공급자는 OMP에서 관리합니다." MaxLength="4096"/>
            <WrapPanel Margin="0,8,0,0"><Button Content="찾기" Click="BrowseOmp_Click"/><Button x:Name="ConnectButton" Content="모델 불러오기" Click="Connect_Click" Margin="0"/></WrapPanel>
            <TextBlock x:Name="ModelStatus" Text="OMP에서 등록한 모델을 가져옵니다." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
            <TextBlock Text="생성 요청은 선택한 공급자의 요금·사용량에 반영됩니다." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14"><TextBlock x:Name="SessionTitle" Text="작업 공간 준비 중" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="SessionBinding" Foreground="#6EDCC6" Margin="0,6,0,0"/><TextBlock x:Name="ModeHint" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
        <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="6" Padding="12" Margin="0,0,0,14">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="115"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="이 작업 공간의 모델" Margin="0,0,0,5"/><ComboBox x:Name="ModelPicker" SelectedValuePath="Id" IsTextSearchEnabled="True" TextSearch.TextPath="Id" MaxDropDownHeight="320">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Id}" Foreground="#13202D" TextWrapping="NoWrap"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="요청 상한" Margin="0,0,0,5"/><TextBox x:Name="RequestLimit" Text="20" MaxLength="4"/></StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="최대 출력 토큰" Margin="0,0,0,5"/><TextBox x:Name="MaxTokens" Text="4096" MaxLength="5"/></StackPanel>
            <Button Grid.Column="3" Content="저장" Click="Save_Click" VerticalAlignment="Bottom" Margin="0"/>
          </Grid>
        </Border>
        <TabControl Grid.Row="2" x:Name="WorkTabs">
          <TabItem Header="대화 · 조언">
            <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBox x:Name="Conversation" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" VerticalContentAlignment="Top" Background="{StaticResource Surface}"/>
              <DockPanel Grid.Row="1" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="대화 비우기" Click="ClearHistory_Click" Margin="8,0,0,0"/><Button DockPanel.Dock="Right" Content="대화 내보내기" Click="ExportConversation_Click" Margin="8,0,0,0"/><TextBlock x:Name="UsageText" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
            </Grid>
          </TabItem>
          <TabItem Header="자료 · 관측">
            <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock x:Name="ContextHint" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
              <TextBox x:Name="ContextEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" VerticalContentAlignment="Top" MaxLength="80000"/>
              <WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="자료 파일 불러오기" Click="ImportContext_Click"/><Button Content="양식 넣기" Click="InsertTemplate_Click"/></WrapPanel>
            </Grid>
          </TabItem>
          <TabItem Header="Lua 초안" x:Name="LuaTab">
            <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="초안을 수정하고 검사한 뒤 별도 .lua 파일로 저장하세요. 게임 내 검증은 따로 필요합니다." Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
              <TextBox x:Name="LuaEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" VerticalContentAlignment="Top" MaxLength="320000"/>
              <WrapPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="Lua 파일 열기" Click="ImportLua_Click"/><Button Content="초안 검사" Click="InspectLua_Click"/><Button Content="검사 후 저장" Click="ExportLua_Click"/></WrapPanel>
              <TextBlock x:Name="LuaStatus" Grid.Row="3" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
            </Grid>
          </TabItem>
        </TabControl>
        <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
          <TextBox x:Name="PromptEditor" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" MaxLength="20000" ToolTip="질문이나 작업 목표를 입력하세요. Ctrl+Enter로 요청합니다." PreviewKeyDown="PromptEditor_PreviewKeyDown"/>
          <StackPanel Grid.Column="1" Margin="12,0,0,0"><Button x:Name="SendButton" Content="AI에 요청" Background="#245B58" Click="Send_Click" Margin="0,0,0,8"/><Button x:Name="CancelButton" Content="요청 취소" Click="Cancel_Click" IsEnabled="False" Margin="0"/></StackPanel>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#111F2D" Padding="24,10" BorderBrush="#344457" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="로컬 작업 공간을 준비하고 있습니다." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Border>
  </Grid>
</Window>
